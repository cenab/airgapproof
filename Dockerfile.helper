FROM --platform=$BUILDPLATFORM golang:1.27.3-bookworm AS build
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends clang linux-libc-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN clang -O2 -g -target bpf -I/usr/include/$(gcc -dumpmachine) -c internal/tracing/bpf/trace.c -o /trace.bpf.o
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -o /helper ./cmd/helper
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /helper /helper
COPY --from=build /trace.bpf.o /trace.bpf.o
ENTRYPOINT ["/helper"]
